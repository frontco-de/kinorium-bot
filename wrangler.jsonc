{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kinorium-bot",
  "account_id": "e4b96293222e2f5a31ed954f03743669",
  "main": "src/app.ts",
  "compatibility_date": "2026-08-15",
  // The Worker answers Telegram on its own hostname only. A custom domain also
  // makes Cache API operations functional, which `workers.dev` does not
  // guarantee, and puts the request behind zone WAF rules; see docs/DEPLOY.md.
  "workers_dev": false,
  // No preview hostnames either: every public URL is one more surface Telegram
  // never uses.
  "preview_urls": false,
  "routes": [
    {
      "pattern": "kinorium.frontco.de",
      "custom_domain": true,
    },
  ],
  "vars": {
    // Public `getMe` metadata.
    "BOT_INFO": {
      "id": 1848460309,
      "is_bot": true,
      "first_name": "KinoriumBot",
      "username": "kinorium_bot",
      "can_join_groups": false,
      "can_read_all_group_messages": false,
      "supports_inline_queries": true,
      "supports_guest_queries": false,
      "can_connect_to_business": false,
      "has_main_web_app": false,
      "has_topics_enabled": false,
      "allows_users_to_create_topics": false,
      "can_manage_bots": false,
      "supports_join_request_queries": false,
    },
  },
  // Names only. `wrangler types` emits these bindings from this list, so type
  // generation stays identical with and without a local `.env`. Values live in
  // Cloudflare secrets; see docs/DEPLOY.md.
  "secrets": {
    "required": ["TOKEN", "APIKEY", "WEBHOOK_SECRET", "ADMIN_ID"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kinorium-bot",
      "migrations_dir": "migrations",
      "database_id": "78807f12-3006-4e46-be7d-b6711a81766d",
    },
  ],
  "ratelimits": [
    {
      "name": "INLINE_RATE_LIMITER",
      // Per Telegram user, per Cloudflare location. Inline typing produces
      // several queries per search, so the window stays generous.
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
    {
      // Guards the database rather than the Kinorium quota: updates over this
      // limit are dropped before any D1 read or write. Set above the inline
      // limit so ordinary typing never reaches it.
      "name": "UPDATE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.yaml", "**/*.sql"],
      "fallthrough": true,
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
}
