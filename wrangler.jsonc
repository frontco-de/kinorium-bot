{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kinorium-bot",
  "main": "src/app.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "vars": {
    "BOT_INFO": {
      // "id": 1848460309,
      // "is_bot": true,
      // "first_name": "KinoriumBot",
      // "username": "kinorium_bot",
      // "can_join_groups": false,
      // "can_read_all_group_messages": false,
      // "supports_inline_queries": true,
      // "can_connect_to_business": false,
      // "has_main_web_app": false,
      "id": 8872819363,
      "is_bot": true,
      "first_name": "KinoriumTest",
      "username": "kinorium_test_bot",
      "can_join_groups": true,
      "can_read_all_group_messages": false,
      "supports_inline_queries": true,
      "supports_guest_queries": true,
      "can_connect_to_business": false,
      "has_main_web_app": false,
      "has_topics_enabled": false,
      "allows_users_to_create_topics": false,
      "can_manage_bots": false,
      "supports_join_request_queries": false,
    },
  },
  "secrets": {
    "required": ["TOKEN", "APIKEY", "WEBHOOK_SECRET"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kinorium-bot",
      "migrations_dir": "migrations",
      "database_id": "78807f12-3006-4e46-be7d-b6711a81766d",
    },
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.yaml", "**/*.sql"],
      "fallthrough": true,
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
}
