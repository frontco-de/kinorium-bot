{
  "name": "kinorium-bot",
  "version": "1.0.1",
  "private": true,
  "description": "Telegram bot for finding movies and tv-shows on Kinorium",
  "repository": "https://github.com/frontco-de/kinorium-bot",
  "author": "Pylyp Borysov <bruha.mail@gmail.com>",
  "license": "MIT",
  "packageManager": "yarn@4.9.1",
  "commit-and-tag-version": {
    "scripts": {
      "postchangelog": "prettier --write CHANGELOG.md"
    }
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "d1:migrate:local": "wrangler d1 migrations apply kinorium-bot --local",
    "d1:migrate:remote": "wrangler d1 migrations apply kinorium-bot --remote",
    "lint": "yarn pretty && eslint --max-warnings 0 . && yarn typecheck",
    "pretty": "prettier --check src test scripts *.ts *.mts *.json *.jsonc *.md docs",
    "release": "node scripts/release.mjs",
    "release:dry-run": "node scripts/release.mjs --dry-run",
    "release:first": "node scripts/release.mjs --first-release",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit --project test/tsconfig.json",
    "types": "wrangler types --env-interface CloudflareBindings",
    "validate": "yarn types && yarn lint && yarn test && yarn build"
  },
  "dependencies": {
    "grammy": "^1.45.1",
    "js-yaml": "^5.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/runner": "^4.1.0",
    "@vitest/snapshot": "^4.1.0",
    "commit-and-tag-version": "^13.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-no-relative-import-paths": "^1.0.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.123.0"
  }
}
